---
import Base from "../../layouts/Base.astro";
import { pistas, rutas, imgDe, CLIPS_BASE } from "../../data/pistas";

export function getStaticPaths() {
  return rutas.map((r) => ({ params: { id: r.id }, props: { r } }));
}

const { r } = Astro.props;
const desde = pistas.find((p) => p.id === r.desde)!;
const hasta = pistas.find((p) => p.id === r.hasta)!;
const atajos = r.atajos ?? [];
---

<Base>
  <a class="volver" href="/">← Volver al mapa</a>

  <!-- DE DÓNDE A DÓNDE: las dos pistas de la ruta, con sus cards. -->
  <header class="cabecera">
    <h1>
      <span class="par"
        ><img src={imgDe(desde, "icono")} alt="" />{desde.nombre}</span
      >
      <span class="flecha" aria-hidden="true">→</span>
      <span class="par"
        ><img src={imgDe(hasta, "icono")} alt="" />{hasta.nombre}</span
      >
    </h1>
  </header>

  {
    r.estrategia && (
      <>
        <div class="bloque-estrategia">
          <h2 class="titulo-estrategia">
            Estrategia
            <button class="ayuda" aria-label="Qué es cada perfil" />
          </h2>
          <div class="roles">
            <p>
              <strong>Runner:</strong> Mejor posición de inicio, primer lugar y
              correr.
            </p>
            <p>
              <strong>Shroomer:</strong> Mejor iniciar en posiciones bajas o
              medias, conseguir champiñones, tomar atajos y correr.
            </p>
            <p>
              <strong>Drafter:</strong> Mejor conseguir rebufos al iniciar la
              carrera, y entonces correr.
            </p>
            <p>
              <strong>Bagger:</strong> Mejor quedarse en posiciones bajas y usar
              tus objetos para remontar al final.
            </p>
          </div>
        </div>
        <p class="estrategia" set:html={r.estrategia} />
      </>
    )
  }

  {
    atajos.length > 0 && (
      <>
        <div class="acciones">
          <button class="btn" id="btn-atajo" aria-pressed="false">
            Atajos de la ruta
          </button>
          {/* El .mini va DENTRO de .acciones a proposito: es el ancla del popup, y
            un position:absolute solo toma como ancla un ancestro. Como hermano se
            leia contra el viewport y caia a la esquina inferior izquierda. */}
          <div id="mini" class="mini oculto">
            {atajos.map((c) => (
              <button class="btn" data-cat={c.id} aria-pressed="false">
                {c.icono && <img src={`/img/items/${c.icono}`} alt="" />}
                {c.nombre}
              </button>
            ))}
          </div>
        </div>

        {atajos.map((c) => (
          <section class="lista oculto" id={`lista-${c.id}`}>
            {c.atajos.map((a) => (
              <article class="atajo">
                {a.clip ? (
                  <video
                    class="clip"
                    src={`${CLIPS_BASE}/${a.clip}`}
                    poster={`${CLIPS_BASE}/${a.clip.replace(/\.mp4$/, ".jpg")}`}
                    controls
                    preload="metadata"
                  />
                ) : (
                  <div class="clip">Clip pendiente</div>
                )}
                <div>
                  <h3>{a.titulo}</h3>
                  <p set:html={a.descripcion} />
                </div>
              </article>
            ))}
          </section>
        ))}
      </>
    )
  }

  <script>
    const $ = (s: string) => document.querySelector<HTMLElement>(s);
    const btnAtajo = $("#btn-atajo");
    const mini = $("#mini");
    const marcar = (el: Element, on: boolean) =>
      el.setAttribute("aria-pressed", String(on));
    const desmarcarCategorias = () =>
      document
        .querySelectorAll("[data-cat]")
        .forEach((x) => marcar(x, false));
    const ocultarListas = () => {
      document
        .querySelectorAll(".lista")
        .forEach((l) => l.classList.add("oculto"));
      desmarcarCategorias();
    };

    btnAtajo?.addEventListener("click", () => {
      mini?.classList.toggle("oculto");
      const abierto =
        mini !== null && mini?.classList.contains("oculto") === false;
      if (btnAtajo) marcar(btnAtajo, abierto);
      if (!abierto) ocultarListas();
    });
    document.querySelectorAll<HTMLElement>("[data-cat]").forEach((b) =>
      b.addEventListener("click", () => {
        ocultarListas();
        marcar(b, true);
        // El popup se cierra al elegir: si queda abierto tapa el primer video.
        mini?.classList.add("oculto");
        if (btnAtajo) marcar(btnAtajo, false);
        $(`#lista-${b.dataset.cat}`)?.classList.remove("oculto");
      }),
    );
  </script>
</Base>
