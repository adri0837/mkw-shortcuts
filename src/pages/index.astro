---
import Base from '../layouts/Base.astro';
import tracks from '../data/tracks.json';
---
<Base>
  <h1 class="titulo">MKW Shortcuts and strategies</h1>

  <!-- MAPA: cada pista es un pin. Ajusta la posición con posMapa {x,y} (%) en src/data/tracks.json -->
  <div class="mapa">
    <img src="/img/mapa-mundo.webp" alt="Mapa de Mario Kart World" />
    {tracks.map((t) => (
      <button class="pin" data-pista={t.id} style={`left:${t.posMapa.x}%;top:${t.posMapa.y}%`} aria-label={t.nombre}>
        <img src={t.icono} alt="" />
      </button>
    ))}
  </div>

  <!-- MENÚ DE PISTA (se abre al hacer clic en un pin) -->
  {tracks.map((t) => (
    <div class="overlay oculto" id={`menu-${t.id}`} role="dialog" aria-label={t.nombre}>
      <div>
        <div class="menu">
          <img class="card" src={t.card} alt={t.nombre} />
          <ul>
            <li><a class="opcion" href={`/pistas/${t.id}`}>{t.nombre}</a></li>
            <!-- TODO: rutas A → B. Agregar aquí las conexiones hacia otras pistas -->
            <li><span class="opcion" aria-disabled="true">Ruta hacia otra pista (próximamente)</span></li>
          </ul>
        </div>
        <button class="btn cerrar" data-cerrar>Cerrar</button>
      </div>
    </div>
  ))}

  <script>
    const abrir = (id: string) => document.getElementById(`menu-${id}`)?.classList.remove('oculto');
    const cerrar = () => document.querySelectorAll('.overlay').forEach((o) => o.classList.add('oculto'));
    document.querySelectorAll<HTMLElement>('.pin').forEach((p) => p.addEventListener('click', () => abrir(p.dataset.pista!)));
    document.querySelectorAll('[data-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
    document.querySelectorAll('.overlay').forEach((o) => o.addEventListener('click', (e) => { if (e.target === o) cerrar(); }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
  </script>
</Base>
