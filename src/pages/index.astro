---
import Base from '../layouts/Base.astro';
import { enElMapa, imgDe, rutasDesde, pistas } from '../data/pistas';

// Lo único que el menú necesita saber de cada pista. Va en el HTML como un
// bloque de datos plano, y el script del final lo lee al hacer clic.
const paraMenu = Object.fromEntries(
  enElMapa().map((p) => {
    const rutasDePista = rutasDesde(p.id);
    return [
      p.id,
      {
        nombre: p.nombre,
        card: imgDe(p, 'card'),
        rutas: rutasDePista.map((r) => {
          const hasta = pistas.find((x) => x.id === r.hasta);
          return {
            id: r.id,
            nombreHasta: hasta?.nombre ?? '',
            href: `/ruta/${r.id}`,
            cards: hasta ? [imgDe(p, 'card'), '/img/going-to.png', imgDe(hasta, 'card')] : [],
          };
        }),
        rutasPendientes: p.rutasPendientes ?? 0,
      },
    ];
  })
);
---
<Base>
  <h1 class="titulo"><span>Mario Kart <i class="letra-w">W</i><i class="letra-o">o</i><i class="letra-r">r</i><i class="letra-l">l</i><i class="letra-d">d</i></span><span>Atajos y Estrategias</span></h1>

  <!-- MAPA: cada pista es un pin. Ajustá la posición con posMapa {x,y} (%) en src/data/pistas.ts -->
  <div class="mapa">
    <img src="/img/mapa-mundo.webp" alt="Mapa de Mario Kart World" />
    {enElMapa().map((p) => (
      <button class="pin" data-pista={p.id} style={`left:${p.posMapa!.x}%;top:${p.posMapa!.y}%`} aria-label={p.nombre}>
        <img src={imgDe(p, 'icono')} alt="" />
      </button>
    ))}
  </div>

  <script type="application/json" id="datos" is:inline set:html={JSON.stringify(paraMenu)} />

  <!-- MENÚ DE PISTA: un solo diálogo para las 30 pistas. Las rutas hacia otras
       pistas entran acá cuando estén. -->
  <dialog id="menu" aria-label="Elegir pista">
    <div class="menu">
      <div id="cards" class="cards"></div>
      <ul id="opciones"></ul>
    </div>
    <button class="btn cerrar" type="button">Cerrar</button>
  </dialog>

  <script>
    type DatosPista = {
      nombre: string;
      card: string;
      rutas: {
        id: string;
        nombreHasta: string;
        href: string;
        cards: string[];
      }[];
      rutasPendientes: number;
    };

    const datos: Record<string, DatosPista> = JSON.parse(
      document.getElementById('datos')!.textContent!
    );
    const dlg = document.getElementById('menu') as HTMLDialogElement;
    const cards = document.getElementById('cards')!;
    const lista = dlg.querySelector('ul')!;

    // `n` imágenes de la fila actual: 1 = la card de la pista, 3 = A → flecha → B.
    // `going` marca la del medio para que el CSS no le imponga el recorte 444x317.
    const pintarCards = (urls: string[], alt: string) => {
      cards.dataset.n = String(urls.length);
      cards.replaceChildren(
        ...urls.map((u) => {
          const img = document.createElement('img');
          img.src = u;
          img.alt = alt;
          if (urls.length === 3 && u === urls[1]) img.className = 'going';
          return img;
        })
      );
    };

    const opcion = (
      texto: string,
      href?: string,
      cardsDeEsta: string[] = [],
      prefijo = ''
    ) => {
      const li = document.createElement('li');
      const el = document.createElement(href ? 'a' : 'span');
      el.className = 'opcion';
      if (href) (el as HTMLAnchorElement).href = href;
      else el.setAttribute('aria-disabled', 'true');
      if (prefijo) {
        const p = document.createElement('span');
        p.className = 'prefijo';
        p.textContent = prefijo;
        el.append(p);
      }
      el.append(document.createTextNode(texto));
      // mouseenter y focus: el teclado tiene que ver el mismo cambio que el mouse.
      // Sin cards no hay nada que pintar. Sin este guard un placeholder borra la
      // card de arriba: data-n=0 no tiene regla y el area se colapsa.
      if (cardsDeEsta.length) {
        el.addEventListener('mouseenter', () => pintarCards(cardsDeEsta, texto));
        el.addEventListener('focus', () => pintarCards(cardsDeEsta, texto));
      }
      li.append(el);
      lista.append(li);
    };

    // Un solo lugar para el texto de "todavía no está": si las pistas que no tienen
    // ruta y las rutas pendientes usaran dos strings distintos, el menú dejaría
    // de ser uniforme.
    const SIN_RUTA = 'Ruta hacia otra pista, próximamente';

    const abrir = (id: string) => {
      const t = datos[id];
      pintarCards([t.card], t.nombre);
      lista.replaceChildren();

      // 1. Opción de la pista principal
      opcion(t.nombre, `/pistas/${id}`, [t.card]);

      // 2. Opciones de cada ruta agregada
      for (const r of t.rutas) {
        opcion(r.nombreHasta, r.href, r.cards, '>>> ');
      }

      // 3. Opciones de "Ruta hacia otra pista, próximamente"
      if (t.rutas.length === 0 && t.rutasPendientes === 0) {
        opcion(SIN_RUTA);
      } else {
        for (let i = 0; i < t.rutasPendientes; i++) {
          opcion(SIN_RUTA);
        }
      }

      dlg.showModal();
    };

    document.querySelectorAll<HTMLElement>('.pin').forEach((p) =>
      p.addEventListener('click', () => abrir(p.dataset.pista!))
    );

    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.querySelector('button')!.addEventListener('click', () => dlg.close());
  </script>
</Base>