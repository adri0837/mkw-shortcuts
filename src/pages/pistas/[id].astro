---
import Base from '../../layouts/Base.astro';
import { pistas, imgDe, CLIPS_BASE } from '../../data/pistas';
export function getStaticPaths() {
  return pistas.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const atajos = p.atajos ?? [];
const hayBala = p.posBala !== undefined;
---
<Base>
  <a href="/">← Volver al mapa</a>

  <header class="cabecera">
    <img src={imgDe(p, 'icono')} alt="" />
    <h1>{p.nombre}</h1>
  </header>

  {p.estrategia && (
    <>
      <h2>Estrategia</h2>
      <p class="estrategia">{p.estrategia}</p>
    </>
  )}

  {(atajos.length > 0 || hayBala) && (
    <div class="acciones">
      {atajos.length > 0 && <button class="btn" id="btn-atajo" aria-pressed="false">Atajo</button>}
      {hayBala && (
        <button class="btn" id="btn-bala" aria-pressed="false">
          <span class="ph"><img src="/img/items/bullet-bill.webp" alt="" /></span>Bala
        </button>
      )}
    </div>
  )}

  <!-- MINI MENÚ DE ATAJOS: los botones salen de atajos[] en src/data/pistas.ts -->
  {atajos.length > 0 && (
    <div id="mini" class="mini oculto">
      {atajos.map((c) => (
        <button class="btn" data-cat={c.id} aria-pressed="false">
          {c.icono && <span class="ph"><img src={`/img/items/${c.icono}`} alt="" /></span>}{c.nombre}
        </button>
      ))}
    </div>
  )}

  <!-- LISTAS DE ATAJOS: clip a la izquierda, descripción a la derecha -->
  {atajos.map((c) => (
    <section class="lista oculto" id={`lista-${c.id}`}>
      {c.atajos.map((a) => (
        <article class="atajo">
          {a.clip
            ? <video
              class="clip"
              src={`${CLIPS_BASE}/${a.clip}`}
              poster={`${CLIPS_BASE}/${a.clip.replace(/\.mp4$/, '.jpg')}`}
              controls
              preload="metadata"
            ></video>
            : <div class="clip">Clip pendiente</div>}
          <div>
            <h3>{a.titulo}</h3>
            <p>{a.descripcion}</p>
          </div>
        </article>
      ))}
    </section>
  ))}

  <!-- MINIMAPA CON LA BALA: ajustá posBala {x,y} (%) en src/data/pistas.ts -->
  {hayBala && (
    <section id="panel-bala" class="oculto">
      <div class="minimapa">
        <img src={imgDe(p, 'minimapa')} alt={`Minimapa de ${p.nombre}`} />
        <span class="bala" style={`left:${p.posBala!.x}%;top:${p.posBala!.y}%`}>
          <img src="/img/items/bullet-bill.webp" alt="" />
        </span>
      </div>
    </section>
  )}

  <script>
    const $ = (s: string) => document.querySelector<HTMLElement>(s);
    const btnAtajo = $('#btn-atajo'), btnBala = $('#btn-bala');
    const mini = $('#mini'), bala = $('#panel-bala');
    const ocultarListas = () => document.querySelectorAll('.lista').forEach((l) => l.classList.add('oculto'));
    const marcar = (el: Element, on: boolean) => el.setAttribute('aria-pressed', String(on));

    btnAtajo?.addEventListener('click', () => {
      mini?.classList.toggle('oculto');
      bala?.classList.add('oculto');
      if (btnBala) marcar(btnBala, false);
      const abierto = !mini?.classList.contains('oculto');
      if (btnAtajo) marcar(btnAtajo, abierto);
      if (!abierto) ocultarListas();
    });
    btnBala?.addEventListener('click', () => {
      const abierto = bala?.classList.toggle('oculto') === false;
      marcar(btnBala, abierto);
      if (abierto) { mini?.classList.add('oculto'); ocultarListas(); if (btnAtajo) marcar(btnAtajo, false); }
    });
    document.querySelectorAll<HTMLElement>('[data-cat]').forEach((b) => b.addEventListener('click', () => {
      ocultarListas();
      document.querySelectorAll('[data-cat]').forEach((x) => marcar(x, false));
      marcar(b, true);
      $(`#lista-${b.dataset.cat}`)?.classList.remove('oculto');
    }));
  </script>
</Base>