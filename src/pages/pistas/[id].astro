---
import Base from "../../layouts/Base.astro";
import { pistas, imgDe, copaDe, CLIPS_BASE } from "../../data/pistas";
export function getStaticPaths() {
  return pistas.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const atajos = p.atajos ?? [];
const balas = p.posBala ?? [];
const hayBala = balas.length > 0;
const copa = copaDe(p.id);
---

<Base>
  <a class="volver" href="/">← Volver al mapa</a>

  <header class="cabecera">
    {copa && <img class="copa" src={copa} alt="" />}
    <h1>{p.nombre}</h1>
    <img class="icono" src={imgDe(p, "icono")} alt="" />
  </header>

  {
    p.estrategia && (
      <>
        <div class="bloque-estrategia">
          <h2 class="titulo-estrategia">
            Estrategia
            <button class="ayuda" aria-label="Qué es cada perfil" />
          </h2>
          <div class="roles">
            <p>
              <strong>Runner:</strong> Mejor posición de inicio, primer lugar y
              correr.
            </p>
            <p>
              <strong>Shroomer:</strong> Mejor iniciar en posiciones bajas o
              medias, conseguir champiñones, tomar atajos y correr.
            </p>
            <p>
              <strong>Drafter:</strong> Mejor conseguir rebufos al iniciar la
              carrera, y entonces correr.
            </p>
            <p>
              <strong>Bagger:</strong> Mejor quedarse en posiciones bajas y usar
              tus objetos para remontar al final.
            </p>
          </div>
        </div>
        <p class="estrategia" set:html={p.estrategia} />
      </>
    )
  }

  {
    (atajos.length > 0 || hayBala) && (
      <div class="acciones">
        {atajos.length > 0 && (
          <button class="btn" id="btn-atajo" aria-pressed="false">
            Atajos
          </button>
        )}
        {hayBala && (
          <div class="ayuda-bala">
            <button class="btn" id="btn-bala" aria-pressed="false">
              <img src="/img/items/bullet-bill.webp" alt="" />
              Extensión de bala
            </button>
            <button class="ayuda" aria-label="Qué es la extensión de bala" />
            <div class="ayuda-panel">
              Una extensión de bala prolonga la duración del objeto al entrar
              en zonas complejas de una pista, obligando a la bala a viajar
              hasta un área a salvo, el efecto puede concluir si se pasan a 5
              corredores en la bala.
            </div>
          </div>
        )}
        {/* El .mini va DENTRO de .acciones a proposito: es el ancla del popup, y
          un position:absolute solo toma como ancla un ancestro. Como hermano se
          leeria contra el viewport y caia a la esquina inferior izquierda. */}
        {atajos.length > 0 && (
          <div id="mini" class="mini oculto">
            {atajos.map((c) => (
              <button class="btn" data-cat={c.id} aria-pressed="false">
                {c.icono && <img src={`/img/items/${c.icono}`} alt="" />}
                {c.nombre}
              </button>
            ))}
          </div>
        )}
      </div>
    )
  }

  <!-- LISTAS DE ATAJOS: clip a la izquierda, descripción a la derecha -->
  {
    atajos.map((c) => (
      <section class="lista oculto" id={`lista-${c.id}`}>
        {c.atajos.map((a) => (
          <article class="atajo">
            {a.clip ? (
              <video
                class="clip"
                src={`${CLIPS_BASE}/${a.clip}`}
                poster={`${CLIPS_BASE}/${a.clip.replace(/\.mp4$/, ".jpg")}`}
                controls
                preload="metadata"
              />
            ) : (
              <div class="clip">Clip pendiente</div>
            )}
            <div>
              <h3>{a.titulo}</h3>
              <p set:html={a.descripcion} />
            </div>
          </article>
        ))}
      </section>
    ))
  }

  <!-- MINIMAPA CON LAS BALAS: posBala es un array en src/data/pistas.ts,
       una entrada por bala ({x,y} en % + img en R2 / texto del panel). -->
  {
    hayBala && (
      <section id="panel-bala" class="oculto">
        <div class="minimapa">
          <img src={imgDe(p, "minimapa")} alt={`Minimapa de ${p.nombre}`} />
          {balas.map((b, i) => (
            <button
              type="button"
              class="bala"
              data-bala={i}
              aria-expanded="false"
              aria-controls={`info-bala-${i}`}
              aria-label={`Extensión de bala ${i + 1}`}
              style={`left:${b.x}%;top:${b.y}%`}
            >
              <img src="/img/items/bullet-bill-front.webp" alt="" />
            </button>
          ))}
        </div>
        {balas.map((b, i) => (
          <div id={`info-bala-${i}`} class="info-bala oculto">
            {b.img ? (
              <div class="clip bala-clip">
                <span class="placeholder-texto">Imagen pendiente</span>
                <img
                  class="bala-img"
                  src={`${CLIPS_BASE}/${b.img}`}
                  alt={`Extensión de bala en ${p.nombre}`}
                  onload="this.parentElement.classList.add('cargada')"
                  onerror="this.parentElement.classList.remove('cargada')"
                />
              </div>
            ) : (
              <div class="clip">Imagen pendiente</div>
            )}
            <p set:html={b.texto ?? "Descripción pendiente."} />
          </div>
        ))}
      </section>
    )
  }

  <script>
    const $ = (s: string) => document.querySelector<HTMLElement>(s);
    const btnAtajo = $("#btn-atajo"),
      btnBala = $("#btn-bala");
    const mini = $("#mini"),
      bala = $("#panel-bala");
    const infoBalas = document.querySelectorAll<HTMLElement>(".info-bala");
    const btnsBala = document.querySelectorAll<HTMLButtonElement>(".bala");
    const marcar = (el: Element, on: boolean) =>
      el.setAttribute("aria-pressed", String(on));
    const desmarcarCategorias = () =>
      document.querySelectorAll("[data-cat]").forEach((x) => marcar(x, false));

    document.querySelectorAll<HTMLImageElement>(".bala-clip .bala-img").forEach((img) => {
      if (img.complete && img.naturalWidth > 0) {
        img.parentElement?.classList.add("cargada");
      }
    });

    const TIEMPO_ANIM = 180;

    const animarEntrada = (el: HTMLElement | null) => {
      if (!el) return;
      el.classList.remove("anim-sale", "oculto");
      el.classList.remove("anim-entra");
      void el.offsetWidth;
      el.classList.add("anim-entra");
    };

    const animarSalida = (el: HTMLElement | null, alTerminar?: () => void) => {
      if (!el || el.classList.contains("oculto")) {
        alTerminar?.();
        return;
      }
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        el.classList.add("oculto");
        el.classList.remove("anim-entra", "anim-sale");
        alTerminar?.();
        return;
      }
      el.classList.remove("anim-entra");
      el.classList.add("anim-sale");
      let terminado = false;
      const fin = () => {
        if (terminado) return;
        terminado = true;
        el.classList.add("oculto");
        el.classList.remove("anim-sale");
        alTerminar?.();
      };
      el.addEventListener("animationend", fin, { once: true });
      setTimeout(fin, TIEMPO_ANIM + 50);
    };

    const ocultarListas = () => {
      document.querySelectorAll<HTMLElement>(".lista:not(.oculto)").forEach((l) => {
        animarSalida(l);
      });
      desmarcarCategorias();
    };

    btnAtajo?.addEventListener("click", () => {
      const abrir = mini?.classList.contains("oculto");
      if (abrir) {
        animarEntrada(mini);
        marcar(btnAtajo, true);
        if (bala && !bala.classList.contains("oculto")) {
          animarSalida(bala);
          if (btnBala) marcar(btnBala, false);
        }
      } else {
        animarSalida(mini);
        marcar(btnAtajo, false);
        ocultarListas();
      }
    });

    btnBala?.addEventListener("click", () => {
      const abrir = bala?.classList.contains("oculto");
      if (abrir) {
        animarEntrada(bala);
        marcar(btnBala, true);
        animarSalida(mini);
        ocultarListas();
        if (btnAtajo) marcar(btnAtajo, false);
      } else {
        animarSalida(bala);
        marcar(btnBala, false);
        infoBalas.forEach((x) => animarSalida(x));
        btnsBala.forEach((b) => b.setAttribute("aria-expanded", "false"));
      }
    });

    // Cada ícono de bala abre SU panel al lado del minimapa: solo uno a la vez.
    btnsBala.forEach((btn) =>
      btn.addEventListener("click", () => {
        const yaAbierto = btn.getAttribute("aria-expanded") === "true";
        btnsBala.forEach((b) => b.setAttribute("aria-expanded", "false"));
        infoBalas.forEach((x) => {
          if (!x.classList.contains("oculto") && x.id !== `info-bala-${btn.dataset.bala}`) {
            animarSalida(x);
          }
        });
        const target = $(`#info-bala-${btn.dataset.bala}`);
        if (yaAbierto) {
          animarSalida(target);
        } else {
          btn.setAttribute("aria-expanded", "true");
          animarEntrada(target);
        }
      }),
    );

    document.querySelectorAll<HTMLElement>("[data-cat]").forEach((b) =>
      b.addEventListener("click", () => {
        const targetId = `lista-${b.dataset.cat}`;
        document.querySelectorAll<HTMLElement>(".lista:not(.oculto)").forEach((l) => {
          if (l.id !== targetId) animarSalida(l);
        });
        desmarcarCategorias();
        marcar(b, true);
        // El popup se cierra al elegir: si queda abierto tapa el primer video.
        animarSalida(mini);
        if (btnAtajo) marcar(btnAtajo, false);
        const target = $(`#${targetId}`);
        animarEntrada(target);
      }),
    );
  </script>
</Base>
