---
import '../styles/global.css';
const { titulo = 'MKWORLD Track Info' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/RacersDelight.woff2" />
    <link rel="icon" type="image/webp" href="/img/dash-food-icon.webp" />
  </head>
  <body><div class="wrap"><slot /></div></body>
</html>